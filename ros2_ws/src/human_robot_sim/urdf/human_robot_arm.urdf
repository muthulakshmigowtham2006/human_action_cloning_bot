<?xml version="1.0"?>

<robot name="human_robot_arm">

    <!-- ================================================= -->
    <!-- BASE -->
    <!-- ================================================= -->

    <link name="base_link">

        <visual>
            <origin xyz="0 0 0.1"/>
            <geometry>
                <cylinder radius="0.3" length="0.2"/>
            </geometry>
            <material name="base_blue">
                <color rgba="0.05 0.30 0.80 1.0"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0.1"/>
            <geometry>
                <cylinder radius="0.3" length="0.2"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0.1"/>
            <mass value="1.0"/>
            <inertia
                ixx="0.01"
                ixy="0.0"
                ixz="0.0"
                iyy="0.01"
                iyz="0.0"
                izz="0.01"/>
        </inertial>

    </link>


    <!-- ================================================= -->
    <!-- LINK 1 -->
    <!-- ================================================= -->

    <link name="link1">

        <visual>
            <origin xyz="0 0 0.5"/>
            <geometry>
                <box size="0.18 0.18 1.0"/>
            </geometry>
            <material name="link1_blue">
                <color rgba="0.10 0.40 0.90 1.0"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0.5"/>
            <geometry>
                <box size="0.18 0.18 1.0"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0.5"/>
            <mass value="1.0"/>
            <inertia
                ixx="0.10"
                ixy="0.0"
                ixz="0.0"
                iyy="0.10"
                iyz="0.0"
                izz="0.01"/>
        </inertial>

    </link>


    <!-- ================================================= -->
    <!-- JOINT 1 -->
    <!-- ================================================= -->

    <joint name="joint1" type="revolute">

        <parent link="base_link"/>
        <child link="link1"/>

        <origin xyz="0 0 0.2"/>

        <axis xyz="0 0 1"/>

        <limit
            lower="-2.5"
            upper="2.5"
            effort="15"
            velocity="2"/>

    </joint>


    <!-- ================================================= -->
    <!-- LINK 2 -->
    <!-- ================================================= -->

    <link name="link2">

        <visual>
            <origin xyz="0 0 0.45"/>
            <geometry>
                <box size="0.16 0.16 0.9"/>
            </geometry>
            <material name="link2_light_blue">
                <color rgba="0.15 0.65 0.95 1.0"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0.45"/>
            <geometry>
                <box size="0.16 0.16 0.9"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0.45"/>
            <mass value="0.8"/>
            <inertia
                ixx="0.06"
                ixy="0.0"
                ixz="0.0"
                iyy="0.06"
                iyz="0.0"
                izz="0.01"/>
        </inertial>

    </link>


    <!-- ================================================= -->
    <!-- JOINT 2 -->
    <!-- ================================================= -->

    <joint name="joint2" type="revolute">

        <parent link="link1"/>
        <child link="link2"/>

        <origin xyz="0 0 1.0"/>

        <axis xyz="0 1 0"/>

        <limit
            lower="-1.57"
            upper="1.57"
            effort="20"
            velocity="2"/>

    </joint>


    <!-- ================================================= -->
    <!-- LINK 3 -->
    <!-- ================================================= -->

    <link name="link3">

        <visual>
            <origin xyz="0 0 0.4"/>
            <geometry>
                <box size="0.14 0.14 0.8"/>
            </geometry>
            <material name="link3_orange">
                <color rgba="0.95 0.40 0.05 1.0"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0.4"/>
            <geometry>
                <box size="0.14 0.14 0.8"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0.4"/>
            <mass value="0.6"/>
            <inertia
                ixx="0.04"
                ixy="0.0"
                ixz="0.0"
                iyy="0.04"
                iyz="0.0"
                izz="0.01"/>
        </inertial>

    </link>


    <!-- ================================================= -->
    <!-- JOINT 3 -->
    <!-- ================================================= -->

    <joint name="joint3" type="revolute">

        <parent link="link2"/>
        <child link="link3"/>

        <origin xyz="0 0 0.9"/>

        <axis xyz="0 1 0"/>

        <limit
            lower="-1.57"
            upper="1.57"
            effort="15"
            velocity="2"/>

    </joint>


    <!-- ================================================= -->
    <!-- END EFFECTOR -->
    <!-- ================================================= -->

    <link name="end_effector">

        <visual>
            <origin xyz="0 0 0.12"/>
            <geometry>
                <box size="0.25 0.25 0.24"/>
            </geometry>
            <material name="end_effector_gray">
                <color rgba="0.80 0.80 0.82 1.0"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0.12"/>
            <geometry>
                <box size="0.25 0.25 0.24"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0.12"/>
            <mass value="0.3"/>
            <inertia
                ixx="0.01"
                ixy="0.0"
                ixz="0.0"
                iyy="0.01"
                iyz="0.0"
                izz="0.01"/>
        </inertial>

    </link>


    <!-- ================================================= -->
    <!-- END EFFECTOR JOINT -->
    <!-- ================================================= -->

    <joint name="end_effector_joint" type="fixed">

        <parent link="link3"/>
        <child link="end_effector"/>

        <origin xyz="0 0 0.8"/>

    </joint>


    <!-- ================================================= -->
    <!-- ROS 2 CONTROL -->
    <!-- ================================================= -->

    <ros2_control name="GazeboSystem" type="system">

        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <joint name="joint1">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="joint2">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="joint3">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

    </ros2_control>


    <!-- ================================================= -->
    <!-- GAZEBO ROS 2 CONTROL PLUGIN -->
    <!-- ================================================= -->

    <gazebo>

        <plugin
            filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">

            <parameters>CONTROLLER_CONFIG_PATH</parameters>

        </plugin>

    </gazebo>

</robot>
